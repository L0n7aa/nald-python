variable        id index 0
variable        T index 1.0
variable        N_atoms index 100
variable        N_molecules index 100
variable        random equal random(10000000,99999999,58545769)
variable        seed equal round(v_random)

log             ./log.lammps

units           lj
atom_style      bond
dimension       3
boundary        p p p

read_data       ${dir_name}/molecules_bonds.data

mass            1 1.0

bond_style      fene
bond_coeff      1 30.0 1.5 1.0 1.0
special_bonds   fene

neighbor        0.5 bin
neigh_modify    every 1 delay 0 check yes
comm_modify     cutoff 3.0

thermo          1000
thermo_style    custom step temp pe ke etotal press density

velocity        all create ${T} ${seed} mom yes rot no dist gaussian

pair_style      soft 1.0
pair_coeff      * * 1.0

variable        A equal ramp(1.0,100.0)
fix             adapt all adapt 1 pair soft a * * v_A

fix             int all nve/limit 0.01
fix             lang all langevin ${T} ${T} 1.0 ${seed}

timestep        0.001
run             50000

unfix           adapt
unfix           int
unfix           lang

pair_style      lj/cut 2.5
pair_modify     shift yes
pair_coeff      * * 1.0 1.0 2.5

timestep        0.00001

fix             int all nve/limit 0.001
fix             lang all langevin ${T} ${T} 1.0 ${seed}

run             50000

unfix           int
unfix           lang

timestep        0.0001

fix             int all nve/limit 0.005
fix             lang all langevin ${T} ${T} 1.0 ${seed}

run             50000

unfix           int
unfix           lang

timestep        0.001

dump            traj all custom 1000 ${dir_name}/trajectory.lammpstrj id mol type x y z ix iy iz
dump_modify     traj sort id

fix             NPH all nph iso 0.0 0.0 1.0
fix             Langevin all langevin ${T} ${T} 1.0 ${seed}

run             50000

unfix           NPH
unfix           Langevin

undump          traj

write_data      ${dir_name}/end.data nocoeff