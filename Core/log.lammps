###############################################
# LAMMPS script for a polymer
###############################################
#Difine Variables
variable        id index 0
variable        N_atoms index 100
variable        N_molecules index 100
#clear

variable        T index 1.0
variable        random equal random(10000000,99999999,58545769)
variable        seed equal round(v_random)


units           lj          # use lennard-jones (i.e. dimensionless) units
atom_style      bond       # atoms with bonds and angles
dimension       3
boundary        p p p       # all boundaries are periodic

read_data       ${dir_name}/end.data    # use the cooled configuration
